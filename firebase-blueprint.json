        "titulo": { "type": "string", "maxLength": 250 },
        "moedaPrincipal": { "type": "string", "enum": ["BRL", "CLP", "USD"] },
        "status": { "type": "string", "enum": ["Rascunho", "Enviado ao Cliente", "Aprovado", "Recusado", "Parcialmente Faturado"] }
      },
      "required": ["numeroOrcamento", "titulo", "moedaPrincipal", "status"]
    },
    "FinancialRecord": {
      "title": "FinancialRecord",
      "description": "Lançamento financeiro (inacessível a assistentes).",
      "type": "object",
      "properties": {
        "caseId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "tipo": { "type": "string", "enum": ["Honorários", "Taxa SERMIG", "Apostila/Tradução", "Despachante/Outros"] },
        "descricao": { "type": "string", "maxLength": 250 },
        "moeda": { "type": "string", "enum": ["BRL", "CLP", "USD"] },
        "valor": { "type": "number" },
        "status": { "type": "string", "enum": ["Pendente", "Pago", "Atrasado"] }
      },
      "required": ["tipo", "descricao", "moeda", "valor", "status"]
    },
    "MessageTemplate": {
      "title": "MessageTemplate",
      "description": "Modelo de mensagem com variáveis dinâmicas.",
      "type": "object",
      "properties": {
        "codigo": { "type": "string", "maxLength": 80 },
        "titulo": { "type": "string", "maxLength": 200 },
        "canal": { "type": "string", "enum": ["WhatsApp", "E-mail", "Ambos"] },
        "corpo": { "type": "string", "maxLength": 5000 }
      },
      "required": ["codigo", "titulo", "corpo"]
    },
    "DocumentTemplate": {
      "title": "DocumentTemplate",
      "description": "Modelo de documento/contrato institucional.",
      "type": "object",
      "properties": {
        "codigo": { "type": "string", "maxLength": 80 },
        "titulo": { "type": "string", "maxLength": 200 },
        "conteudoHtml": { "type": "string", "maxLength": 30000 }
      },
      "required": ["codigo", "titulo", "conteudoHtml"]
    },
    "GeneratedDocument": {
      "title": "GeneratedDocument",
      "description": "Documento gerado para o cliente/caso.",
      "type": "object",
      "properties": {
        "tipo": { "type": "string", "maxLength": 80 },
        "titulo": { "type": "string", "maxLength": 250 },
        "clientId": { "type": "string", "maxLength": 128 },
        "caseId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Rascunho", "Revisado", "Enviado", "Assinado", "Arquivado"] },
        "codigoVerificacao": { "type": "string", "maxLength": 64 },
        "confirmadoLeituraEm": { "type": "string", "format": "date-time" },
        "assinadoEm": { "type": "string", "format": "date-time" },
        "motivoCancelamento": { "type": "string", "maxLength": 1000 },
        "liberadoAoCliente": { "type": "boolean" },
        "financeiro": { "type": "boolean" }
      },
      "required": ["tipo", "titulo", "clientId", "liberadoAoCliente"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Ativo visual da biblioteca de mídia (logos, favicons, banners, fotos institucionais).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "categoria": { "type": "string", "enum": ["logo", "favicon", "banner", "equipe", "geral"] },
        "mimeType": { "type": "string", "maxLength": 100 },
        "url": { "type": "string", "maxLength": 500000 },
        "largura": { "type": "number" },
        "altura": { "type": "number" },
        "tamanhoBytes": { "type": "number" },
        "uploadedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome", "categoria", "mimeType", "url", "tamanhoBytes", "createdAt"]
    },
    "FcmTokenRecord": {
      "title": "FcmTokenRecord",
      "description": "Token de dispositivo Web Push / Firebase Cloud Messaging vinculado a um usuário/cliente.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "token": { "type": "string", "minLength": 10, "maxLength": 512 },
        "plataforma": { "type": "string", "enum": ["web", "android", "ios"] },
        "userAgent": { "type": "string", "maxLength": 250 },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "clientId", "token", "ativo", "createdAt", "updatedAt"]
    },
    "ClientNotification": {
      "title": "ClientNotification",
      "description": "Notificação persistida e enviada via push FCM ao cliente sobre atualizações do processo.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "caseId": { "type": "string", "maxLength": 128 },
        "titulo": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mensagem": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "tipo": { "type": "string", "enum": ["etapa_pipeline", "status_sermig", "documento", "parecer", "prazo", "geral"] },
        "etapaPipeline": { "type": "number" },
        "statusSermig": { "type": "string", "maxLength": 80 },
        "linkDestino": { "type": "string", "maxLength": 200 },
        "lida": { "type": "boolean" },
        "lidaEm": { "type": "string", "format": "date-time" },
        "pushEnviado": { "type": "boolean" },
        "pushEnviadosQtd": { "type": "number" },
        "criadoPorUid": { "type": "string", "maxLength": 128 },
        "criadoPorNome": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientId", "titulo", "mensagem", "tipo", "lida", "createdAt"]
    }
  },
