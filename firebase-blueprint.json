        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nome": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "fotoUrl": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["admin", "consultor", "assistente", "cliente"] },
        "status": { "type": "string", "enum": ["ativo", "pendente", "inativo"] },
        "clientId": { "type": "string", "maxLength": 128 },
