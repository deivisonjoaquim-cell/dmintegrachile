# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of emails automatically provisioned with admin role on first Google login.
ADMIN_EMAILS="admin@dmintegrachile.com"

# Gemini AI Layer Config (models configurable without code changes)
GEMINI_MODEL_PRIMARY="gemini-4-hydrogen"
GEMINI_MODEL_FALLBACK="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_MS="40000"
GEMINI_MAX_ATTEMPTS="4"

# Alternativas gratuitas de IA na nuvem (excelentes para Vercel Gratuito / Hobby com limite de 10s):
# Se GEMINI_API_KEY não estiver definida ou atingir limite, o servidor usa automaticamente Groq ou OpenRouter.
# Groq (gratuito em console.groq.com — respostas em <1s com Llama 3.3 70B):
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# OpenRouter (modelos gratuitos em openrouter.ai):
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Firebase Cloud Messaging (Web Push public VAPID key from Firebase Console -> Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=""

# Nodemailer / E-mail Automation (Lembretes automáticos 30 dias antes da expiração de vistos e documentos)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="D&M Integra Chile <noreply@dmintegrachile.com>"
SMTP_REPLY_TO=""
EXPIRATION_ALERT_DAYS="30"
EXPIRATION_EMAIL_COOLDOWN_DAYS="7"

# Google Maps Platform (JavaScript API for interactive Chile Partner Geolocation Map)
VITE_GOOGLE_MAPS_API_KEY=""
